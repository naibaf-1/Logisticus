<?xml version="1.0"?>
<robot name="" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="main_body" params="x y z">
    <!-- Write some normal URDF code -->
    <link name="base_link"> <!-- Used as the base_link -->
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${x*3} ${y*3} ${z*3}"/>
        </geometry>
        <material name="red">
          <color rgba="0.8 0.1 0.1 1.0"/>
        </material>
      </visual>
    </link>
  </xacro:macro>
</robot>
